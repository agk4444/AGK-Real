define function grade that takes score as Integer and returns String:
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    else:
        return "F"

define function main:
    print(grade(95))
    print(grade(82))
    print(grade(71))
    print(grade(40))
