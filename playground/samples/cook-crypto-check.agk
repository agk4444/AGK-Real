import crypto

to check with pw as String, salt as String, want as String and returns Boolean:
    return compare_digest(pbkdf2_hex(pw, salt, 100000), want)

to main:
    salt is "fixed-salt-for-demo"
    stored is pbkdf2_hex("s3cret", salt, 100000)
    say check("s3cret", salt, stored)
    say check("wrong", salt, stored)
